# ---------------------------------------------------------------------------
# PharmacyFinder – Environment variables
#
# NEXT_PUBLIC_USE_FIXTURES=true  → use fixture data (no live API needed)
# NEXT_PUBLIC_USE_FIXTURES=false → hit real API at NEXT_PUBLIC_API_BASE
#
# To integrate with the live backend: flip to false and set the API base URL.
# No code changes required.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_USE_FIXTURES=false

# Live API endpoint – only used when USE_FIXTURES=false
NEXT_PUBLIC_API_BASE=http://localhost:8000
